# Só NOMES. Nunca coloque valores reais aqui nem no repositório.
# Valores: na Dory (Bitwarden Secrets Manager, injetados por `bws run`) ou nas variáveis da Vercel.

# ---------- Worker (VPS) ----------
DATABASE_URL=                           # connection string do usuário jarvis_worker_login
JARVIS_REGRAS=config/regras.yaml
JARVIS_WORKER_ID=
JARVIS_CORE_APROVACAO_SEGREDO=          # mín. 32 caracteres (mesmo valor no painel)
JARVIS_CORE_NEXUS_AVISOS_URL=           # endpoint do Nexus que manda WhatsApp ao Breno
JARVIS_CORE_NEXUS_WEBHOOK_SEGREDO=      # mín. 32 (mesmo valor no painel e no Nexus)
BWS_ACCESS_TOKEN=                       # token da conta de máquina do Jarvis (Dory)
JARVIS_CORE_BITWARDEN_ORG_ID=
JARVIS_BITWARDEN_PROJETO_PADRAO=jarvis-core
JARVIS_CORE_VERCEL_TOKEN=
JARVIS_CORE_SUPABASE_TOKEN=
JARVIS_CORE_META_ADS_TOKEN=
JARVIS_META_API_VERSAO=v21.0
JARVIS_CORE_ANTHROPIC_API_KEY=          # agente de oferta / Maestro sozinho (opcional se o Claude propõe via MCP)
JARVIS_MODELO_IA=
JARVIS_CORE_GMAIL_CLIENT_ID=
JARVIS_CORE_GMAIL_CLIENT_SECRET=
JARVIS_CORE_GMAIL_REFRESH_TOKEN=
JARVIS_GMAIL_TOPICO_PUBSUB=             # projects/<projeto>/topics/<tópico>
JARVIS_CORE_BROWSERBASE_API_KEY=
JARVIS_BROWSERBASE_PROJETO=

# ---------- Painel (Vercel) ----------
# DATABASE_URL=                         # connection string do usuário jarvis_painel_login
JARVIS_PAINEL_URL=                      # endereço público do painel (OAuth do conector)
NEXT_PUBLIC_SUPABASE_URL=               # login do Breno (Supabase Auth do projeto do Jarvis)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
JARVIS_PAINEL_EMAILS=                   # e-mails autorizados, separados por vírgula
JARVIS_PAINEL_AUTH=                     # "senha" só em desenvolvimento
JARVIS_PAINEL_SENHA=                    # só no modo senha
JARVIS_PAINEL_SEGREDO_COOKIE=           # só no modo senha (mín. 32)
JARVIS_CORE_MCP_TOKEN=                  # token fixo do conector para o Claude Code (mín. 32)
JARVIS_CORE_PULSO_TOKEN=                # /api/saude (mín. 32)
JARVIS_CORE_ASAAS_WEBHOOK_TOKEN=
JARVIS_CORE_HOTMART_HOTTOK=
JARVIS_CORE_GMAIL_PUSH_TOKEN=           # /api/gmail/push?token=… (mín. 32)
